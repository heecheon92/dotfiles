# macOS metadata
.DS_Store

# Nix build output symlinks
result
result-*

# Common credentials and machine-local secrets
.env
.env.*
!.env.example
*.key
*.p12
*.pem
home/.codex/
home/.ssh/
home/.git-credentials
home/.netrc
home/.config/gh/hosts.yml

# OMP uses adjacent lock files while updating portable configuration.
home/.omp/agent/*.lock

# Pi portable sources are allowlisted below. Credentials, sessions, trust
# decisions, caches, and downloaded packages must remain machine-local.
home/.pi/agent/*
!home/.pi/agent/extensions/
!home/.pi/agent/extensions/**
!home/.pi/agent/models.json
!home/.pi/agent/settings.json
!home/.pi/agent/themes/
!home/.pi/agent/themes/**
home/.pi/agent/extensions/**/node_modules/
home/.pi/agent/extensions/**/.cache/
home/.pi/agent/extensions/**/dist/

# Herdr machine-local runtime state. Track only the portable configuration and
# intentional helper scripts from this otherwise live, generated directory.
home/.config/herdr/*
!home/.config/herdr/config.toml
!home/.config/herdr/scripts/
!home/.config/herdr/scripts/**
